{
  "app": {
    "name": "pop-go",
    "version": "0.0.1",
    "lang": "ru",
    "temp_folder": ""
  },
  "log": {
    "level": "debug",
    "type": "text",
    "file": "log"
  },
  "obfuscator": {
    "target_path": "../absolute/or/relative/path/to/go.mod",
    "seed": 0,
    "comments": true,
    "literals": {
      "level": "easy"
    }
  },
  "builder": {
    "flags": ["-ldflags", "-s -w", "-trimpath"],
    "goos": "windows",
    "goarch": "amd64",
    "output_path": "/absolute/output/dir/path"
  }
}
